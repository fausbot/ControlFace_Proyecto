rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── 1. LICENCIAS ──────────────────────────────────────────────────────────
    // Lectura pública necesaria para validar la app antes del login.
    // Escritura restringida: Solo permite tokens válidos tipo string (no vacíos ni corruptos).
    match /settings/license {
      allow read: if true;
      allow write: if request.resource.data.token is string && request.resource.data.token.size() > 20;
    }

    // ─── 2. CONFIGURACIÓN GENERAL ──────────────────────────────────────────────
    // Lectura pública para parámetros visuales y de empresa.
    // Escritura permitida para configuración administrativa.
    match /settings/config {
      allow read: if true;
      allow write: if true;
    }

    // ─── 3. CAMPOS DE EMPLEADOS ────────────────────────────────────────────────
    match /settings/employeeFields {
      allow read: if true;
      allow write: if true;
    }

    // ─── 4. COLA DE BORRADO ───────────────────────────────────────────────────
    match /deletionQueue/{id} {
      allow read, write: if true;
    }
    
    // ─── 5. ASISTENCIA Y NOVEDADES ─────────────────────────────────────────────
    // Valida que cualquier creación o modificación incluya el campo obligatorio 'usuario'.
    match /attendance/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.usuario is string && request.resource.data.usuario.size() > 0;
      allow delete: if true;
    }

    // ─── 6. FOTOS DE ASISTENCIA / VISOR ───────────────────────────────────────
    match /fotos/{id} {
      allow read: if true;
      allow create, update: if (request.resource.data.usuario is string && request.resource.data.usuario.size() > 0) 
                            || (request.resource.data.url is string && request.resource.data.url.size() > 0);
      allow delete: if true;
    }

    // ─── 7. INCIDENTES ────────────────────────────────────────────────────────
    match /incidents/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.usuario is string && request.resource.data.usuario.size() > 0;
      allow delete: if true;
    }
    
    // ─── 8. VISITAS A CLIENTES EN RUTA ────────────────────────────────────────
    match /visitas/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.usuario is string && request.resource.data.usuario.size() > 0;
      allow delete: if true;
    }
    
    // ─── 9. EMPLEADOS (BLINDAJE TOTAL) ────────────────────────────────────────
    // Lectura pública para validación biométrica facial.
    // ESCRITURA PROHIBIDA DESDE EL CLIENTE: Altas, bajas y ediciones SOLO las realiza
    // el backend seguro de Cloud Functions vía Admin SDK.
    match /employees/{id} {
      allow read: if true;
      allow write: if false;
    }
    
    // ─── 10. RESTO DE DOCUMENTOS ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
